    {
      "parameters": {
        "jsCode": "const text = $json.text || '';\nconst items = [];\n\n// 1) Extract product titles from each line item\n// We first grab the full description cell between \"Wrap & Wish\" and \"HSN:\"\nconst reDesc = /Wrap & Wish([\\s\\S]*?)HSN:/gi;\nlet m;\n\nwhile ((m = reDesc.exec(text)) !== null) {\n  let fullDesc = m[1].replace(/\\s+/g, ' ').trim(); // normalize spaces\n\n  // Prefer cutting at explicit suffixes:\n  // \"Wall Posters Set\", \"Wall Split Posters Set\", \"Wall Art Frame\"\n  const explicitSuffix = /\\sWall(?: Split)? (Posters Set|Art Frame)/i;\n  const explicitMatch = fullDesc.match(explicitSuffix);\n\n  let titlePart;\n\n  if (explicitMatch) {\n    // Cut before the explicit suffix\n    titlePart = fullDesc.slice(0, explicitMatch.index).trim();\n  } else {\n    // Fallback: use last \" Wall...\" pattern\n    const wallRegex = /\\sWall(?: Split)?(?: Posters Set| Art Frame| Posters)?/gi;\n    let lastWallIndex = -1;\n    let wallMatch;\n    while ((wallMatch = wallRegex.exec(fullDesc)) !== null) {\n      lastWallIndex = wallMatch.index;\n    }\n    titlePart = lastWallIndex === -1\n      ? fullDesc\n      : fullDesc.slice(0, lastWallIndex).trim();\n  }\n\n  // Remove leading brand if present\n  titlePart = titlePart.replace(/^Wrap & Wish\\s*/i, '').trim();\n\n  // Remove trailing \"Split\" if present\n  titlePart = titlePart.replace(/\\s+Split\\b/i, '').trim();\n\n  if (titlePart) {\n    items.push({\n      searchTitle: titlePart,\n      index: m.index,\n      fullDesc,\n    });\n  }\n}\n\n// 2) For each item, look ahead for size, SKU, qty, and category\nfor (const item of items) {\n  const slice = text.slice(item.index);\n  let size = 'OTHER';\n  let sku = '';\n  let qty = 1;\n\n  // (A3 Size, ...) or (A4 Size, ...)\n  const sizeMatch = slice.match(/\\(A[34]\\s+Size/i);\n  if (sizeMatch) {\n    const upper = sizeMatch[0].toUpperCase();\n    if (upper.includes('A3')) size = 'A3';\n    else if (upper.includes('A4')) size = 'A4';\n  }\n\n  // SKU: last (...) before HSN:, allow whitespace/newlines before HSN\n  const skuMatch = slice.match(/\\(\\s*([^)]+?)\\s*\\)[\\s\\r\\n]*HSN:/i);\n  if (skuMatch) {\n    sku = skuMatch[1].trim();\n  }\n\n  // Qty detection\n  // 1) Markdown-table style: \"256.19 | 2 | 512.38\"\n  let qtyMatch = slice.match(/\\|\\s*\\d+(\\.\\d+)?\\s*\\|\\s*(\\d+)\\s*\\|/);\n\n  if (!qtyMatch) {\n    // 2) Plain-text style: \"\u20b9256.19 2 \u20b9512.38\"\n    qtyMatch = slice.match(/\u20b9?\\s*\\d+(\\.\\d+)?\\s+(\\d+)\\s+\u20b9?\\s*\\d+(\\.\\d+)?/);\n  }\n\n  if (qtyMatch && qtyMatch[2]) {\n    qty = parseInt(qtyMatch[2], 10) || 1;\n  }\n\n  // Category: music if description contains either phrase\n  const descLower = item.fullDesc.toLowerCase();\n  const isMusic =\n    descLower.includes('vintage music & marvel room decor') ||\n    descLower.includes('vintage designs & room decor');\n\n  const category = isMusic ? 'music' : 'new';\n\n  item.size = size;\n  item.sku = sku;\n  item.qty = qty;\n  item.category = category;\n}\n\n// 3) Aggregate by SKU across all invoices, summing qty\nconst bySku = new Map(); // sku -> {title, size, totalQty, category}\n\nfor (const it of items) {\n  const key = it.sku || it.searchTitle; // fallback to title if sku missing\n  if (!bySku.has(key)) {\n    bySku.set(key, {\n      title: it.searchTitle,\n      size: it.size,\n      totalQty: it.qty,\n      category: it.category,\n    });\n  } else {\n    const prev = bySku.get(key);\n    prev.totalQty += it.qty;\n    // keep existing category\n    bySku.set(key, prev);\n  }\n}\n\n// 4) Expand to one item per unit (no qty field in output)\nconst output = [];\n\nfor (const [sku, data] of bySku.entries()) {\n  const { title, size, totalQty, category } = data;\n\n  for (let i = 0; i < totalQty; i++) {\n    output.push({\n      json: {\n        searchTitle: title,\n        size: size,\n        sku: sku,\n        category: category,   // \"music\" or \"new\"\n      },\n    });\n  }\n}\n\nreturn output;\n"
      },
